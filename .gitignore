# ============================================================
# ADEF_remake/eval/ — track the source code, ignore heavy artifacts
# ============================================================
#
# We DO track /eval/ as a whole so the evaluation code (Python scripts,
# shell scripts, READMEs, lightweight configs) can be committed.
# Everything below scopes large/binary/runtime-generated content to /eval/
# and is *additive* — it does not change behavior elsewhere in the repo.

# ---------- Media files (covers RESULT/*.mp4 and the test sample) ----------
*.mp4
*.avi
*.mov
*.mkv
*.wav
*.flac

# ---------- Spreadsheets / large JSON-lines dumps from eval runs ----------
*.xlsx
*.jsonl

# ---------- Inside /eval/: virtual environments ----------
/eval/**/venv/
/eval/**/.venv/
/eval/**/env/
/eval/**/.env/
/eval/**/ENV/
/eval/**/syncnet_venv/

# ---------- Inside /eval/: model checkpoints & pretrained weights ----------
# By extension (covers pth/pt/ckpt/bin/safetensors/onnx/model/dat/npy)
/eval/**/*.pth
/eval/**/*.pth.tar
/eval/**/*.pt
/eval/**/*.ckpt
/eval/**/*.bin
/eval/**/*.safetensors
/eval/**/*.onnx
/eval/**/*.model
/eval/**/*.dat
# Negate small data .npy files that the eval scripts actually read
!/eval/evaluation_eat/code/base_68.npy
!/eval/evaluation_eat/code/base_68_close.npy
!/eval/evaluation_eat/code/rand_sample_lrw_filter100.npy
!/eval/evaluation_eat/code/rand_sample_ours_mead100.npy

# Pretrained-weights directories (ignore contents, keep README files)
/eval/Emotion-FAN/pretrain_model/*
!/eval/Emotion-FAN/pretrain_model/readme.md
/eval/emonet/pretrained/*
/eval/New_Emo/weights/*
/eval/New_Emo/DFER-CLIP/checkpoint/*
/eval/New_Emo/DFER-CLIP/log/*
/eval/evaluation_eat/checkpoints/*
!/eval/evaluation_eat/checkpoints/README.md
/eval/evaluation_eat/code/pretrain_model/*
/eval/pytorch-fid/models_cache/*
/eval/syncnet_python/data/*

# ---------- Inside /eval/: test results & runtime outputs ----------
# RESULT/ holds per-method output videos + summary CSVs
/eval/RESULT/
/eval/eval_reports/
/eval/reports/test/

# evaluation_eat outputs / logs / intermediate results
/eval/evaluation_eat/outputs/
/eval/evaluation_eat/logs/
/eval/evaluation_eat/result/
/eval/evaluation_eat/talking_head_testing/
